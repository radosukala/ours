# Copy this file to .env and fill it in. Never commit .env: git ignores it.

# The address of the club page, used in the links in the reminder email,
# such as https://book-club.example.test
SITE_URL=

# The port the page listens on. Default: 3000.
PORT=

# Where the SQLite database file is kept. Default: storage/book-club.db
DATABASE_PATH=

# Resend, for the monthly reminder: the API key, and the sender address,
# such as Book club <club@example.test>
RESEND_API_KEY=
REMINDER_FROM=
