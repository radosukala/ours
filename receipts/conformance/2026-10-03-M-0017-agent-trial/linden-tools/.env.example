# The settings Linden Tools reads. Copy this file to .env for `npm run dev`, and fill it in there.
# .env is never committed (.gitignore keeps it out).

# The address people reach Linden Tools at; sign-in links point there. Default: http://localhost:3000
BASE_URL=
# The port it listens on. Default: 3000
PORT=
# The SQLite database file. Default: var/linden-tools.db (git ignores database files)
DATABASE_PATH=
# The code people need to join, given out on Linden Row. At least 8 characters.
STREET_CODE=
# The key for Resend, which sends the sign-in emails. Left empty, nothing is sent: emails are printed, and only on localhost.
RESEND_API_KEY=
# The address sign-in emails come from, when RESEND_API_KEY is set. Resend sends to other people only from a domain verified with it.
MAIL_FROM=
